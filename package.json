{
  "name": "agent-brain",
  "version": "0.1.0",
  "description": "Stateful memory · emotion · drives loop for LLM chat agents: three-tier memory, PAD affect, autonomous behavior, over SQLite. Zero dependencies.",
  "type": "module",
  "main": "src/brain.mjs",
  "exports": {
    ".": "./src/brain.mjs",
    "./autonomy": "./src/autonomy.mjs",
    "./config": "./src/config.mjs",
    "./hooks": "./src/hooks.mjs"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node src/demo.mjs",
    "demo:autonomy": "node src/demo-autonomy.mjs",
    "test": "node --test tests",
    "status": "node src/cli.mjs status",
    "tick": "node src/cli.mjs tick",
    "reflect": "node src/cli.mjs reflect",
    "recall": "node src/cli.mjs recall"
  },
  "keywords": [
    "llm",
    "agent",
    "memory",
    "long-term-memory",
    "emotion",
    "pad",
    "autonomy",
    "chatbot",
    "sqlite",
    "rag"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "author": "AZedlyLove",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AZedlyLove/agent-brain.git"
  },
  "homepage": "https://github.com/AZedlyLove/agent-brain#readme",
  "bugs": {
    "url": "https://github.com/AZedlyLove/agent-brain/issues"
  },
  "license": "MIT"
}
